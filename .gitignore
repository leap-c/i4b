# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
.env/
.env.local

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# IDE / Editor
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/

# Logs & reports
logs/
*.log

# Experiment tracking
wandb/
runs/
lightning_logs/

# Results generated by MPC runs
results_mpc/

# Data that should not be versioned (keep metadata/code only)
# NOTE: keep tracked source files under data/, but ignore temporary exports
/data/**/*.tmp
/data/**/*.bak

# Auto-downloaded PVGIS weather data (can be regenerated)
data/weather/pvgis_*.json

# TensorBoard
.tensorboard/

# Coverage / testing
.coverage
htmlcov/
.tox/
pytest_cache/

# Local overrides
*.local
*.secret

# The benchmark corpus and its source data: regenerable, and far too large to track. Only the
# directory structure and its READMEs are kept, so a fresh clone shows where data belongs.
# (benchmark/scripts/prepare_benchmark_data.py fetches the source data.)
/benchmark/production/**
!/benchmark/production/README.md
/benchmark/source-data/**
!/benchmark/source-data/README.md
!/benchmark/source-data/raw/
!/benchmark/source-data/raw/.gitkeep
!/benchmark/source-data/normalized/
!/benchmark/source-data/normalized/.gitkeep
!/benchmark/source-data/manifests/
!/benchmark/source-data/manifests/.gitkeep
/benchmark/i4b-benchmark*/

# marimo session caches
__marimo__/
